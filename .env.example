# คัดลอกเป็นไฟล์ .env.local แล้วใส่ค่าจาก Supabase → Project Settings → API
# ถ้าเว้นว่าง เว็บจะทำงานโหมดเดโม (localStorage + รหัสผ่านแอดมิน)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# endpoint สำหรับดึงหัวข้อ/ภาพจากลิงก์ (ค่าเริ่มต้น 'actions') — ใช้ Supabase Edge Function ใน supabase/functions/actions
VITE_ACTIONS_URL=
